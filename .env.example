# ==========================================================
# ATTech Materials - AWS EC2 後端環境變數配置範本 (.env)
# ==========================================================
# 部署至 EC2 時，請複製此檔案為 .env 並填入實際數值：
# cp .env.example .env

# 伺服器監聽 Port (預設 3000，若由 Nginx 反向代理通常維持 3000)
PORT=3000
NODE_ENV=production

# ----------------------------------------------------------
# 方式一：企業 SMTP 信箱發信 (Nodemailer)
# ----------------------------------------------------------
SMTP_HOST=mail.attech.com.tw
SMTP_PORT=465
SMTP_USER=atservice@attech.com.tw
SMTP_PASS=your_email_password_here
SMTP_SECURE=true

# ----------------------------------------------------------
# 方式二：Resend 雲端郵件 API (若填寫將優先使用 Resend)
# ----------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# FROM_EMAIL=ATTech 官網系統 <service@attech.com.tw>
# TO_EMAIL=atservice@attech.com.tw

# ----------------------------------------------------------
# 額外允許的 CORS 跨域來源 (多個網址請以逗號分隔)
# ----------------------------------------------------------
# ALLOWED_ORIGINS=https://www.attech.com.tw,https://attech.com.tw
